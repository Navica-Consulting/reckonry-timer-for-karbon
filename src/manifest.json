{
  "manifest_version": 3,
  "name": "Reckonry Timer for Karbon (beta draft)",
  "version": "0.7.17",
  "description": "Stopwatch tools for the Karbon timer: start from anywhere, auto-switch, reminders, and lock or idle pause.",
  "permissions": [
    "storage",
    "idle",
    "alarms",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "https://app2.karbonhq.com/*",
    "https://*.karbonhq.com/*"
  ],
  "icons": {
    "16": "icons/icon16-face.png",
    "32": "icons/icon32-face.png",
    "48": "icons/icon48-face.png",
    "128": "icons/icon128-face.png"
  },
  "options_ui": {
    "page": "welcome.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Reckonry Timer for Karbon",
    "default_icon": {
      "16": "icons/icon16-light.png",
      "32": "icons/icon32-light.png",
      "48": "icons/icon48-light.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open the Karbon timer"
    },
    "toggle-timer": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Start, pause, or resume the Karbon timer"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app2.karbonhq.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app2.karbonhq.com/*"
      ],
      "js": [
        "defaults.js",
        "notes.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
